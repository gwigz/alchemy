<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel
 background_opaque="false"
 background_visible="true"
 bg_alpha_color="InventoryExplorerHeaderBackgroundColor"
 follows="all"
 height="58"
 layout="topleft"
 name="panel_al_inventory_explorer_holding_tray"
 width="500">
  <view_border
   bevel_style="none"
   follows="left|top|right"
   height="1"
   highlight_dark_color="InventoryExplorerDividerColor"
   highlight_light_color="InventoryExplorerDividerColor"
   layout="topleft"
   left="0"
   right="-1"
   shadow_dark_color="InventoryExplorerDividerColor"
   shadow_light_color="InventoryExplorerDividerColor"
   top="0" />
  <text
   follows="left|top"
   font="SansSerifSmall"
   font.style="NORMAL"
   height="16"
   layout="topleft"
   left="8"
   name="holding_label"
   text_color="LabelTextColor"
   top="4"
   width="120">Holding shelf</text>
  <button
   follows="right|top"
   height="18"
   image_color="InventoryExplorerControlHoverColor"
   image_hover_unselected="Rounded_Square"
   image_selected="Transparent"
   image_unselected="Transparent"
   label="Clear"
   layout="topleft"
   name="clear_button"
   right="-6"
   top="2"
   width="44" />
  <flat_list_view
   allow_select="false"
   bottom="-2"
   follows="all"
   item_pad="1"
   layout="topleft"
   left="4"
   name="holding_items"
   no_items_text="Drag inventory here to hold it"
   right="-4"
   top="22" />
</panel>
