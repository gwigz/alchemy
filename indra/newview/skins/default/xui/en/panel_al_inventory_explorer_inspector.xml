<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel
 background_visible="false"
 follows="all"
 height="620"
 layout="topleft"
 name="panel_al_inventory_explorer_inspector"
 width="240">
  <panel
   background_visible="false"
   bottom="-1"
   follows="all"
   left="0"
   layout="topleft"
   name="empty_panel"
   right="-1"
   top="0">
    <icon
     color="EmphasisColor"
     follows="top"
     height="16"
     image_name="InvExplorer_Inspector"
     layout="topleft"
     left="112"
     name="inspector_icon"
     top="170"
     width="16" />
    <text
     follows="left|top|right"
     font="SansSerifSmall"
     font.style="BOLD"
     halign="center"
     height="18"
     layout="topleft"
     left="20"
     name="inspector_title"
     right="-20"
     text_color="White"
     top="197">INSPECTOR</text>
    <text
     follows="left|top|right"
     halign="center"
     height="42"
     layout="topleft"
     left="24"
     name="inspector_empty_message"
     right="-24"
     text_color="LabelTextColor"
     top="222"
     valign="top"
     word_wrap="true">Select an inventory item to inspect its details.</text>
  </panel>
  <scroll_container
   color="InventoryBackgroundColor"
   follows="all"
   layout="topleft"
   left="0"
   name="details_scroll"
   opaque="true"
   right="-1"
   top="0"
   bottom="-1"
   visible="false">
    <panel
     background_visible="false"
     follows="left|top|right"
     height="500"
     layout="topleft"
     left="0"
     name="details_panel"
     top="0"
     width="220">
      <text
       follows="left|top|right"
       font="SansSerifSmall"
       font.style="BOLD"
       height="18"
       layout="topleft"
       left="14"
       name="details_title"
       right="-14"
       text_color="White"
       top="14">DETAILS</text>
      <thumbnail
       fallback_image="Thumbnail_Fallback"
       follows="left|top"
       height="96"
       interactable="false"
       layout="topleft"
       left="14"
       name="item_thumbnail"
       top="42"
       width="96" />
      <icon
       color="LabelTextColor"
       follows="left|top"
       height="48"
       image_name="InvExplorer_Inspector"
       layout="topleft"
       left="38"
       name="item_type_icon"
       top="66"
       width="48" />
      <text
       follows="left|top|right"
       font="SansSerifSmall"
       font.style="BOLD"
       height="38"
       layout="topleft"
       left="122"
       name="item_name"
       right="-14"
       text_color="White"
       top="44"
       use_ellipses="true"
       word_wrap="true">Item</text>
      <text
       follows="left|top|right"
       height="34"
       layout="topleft"
       left="122"
       name="item_type"
       right="-14"
       text_color="LabelTextColor"
       top="88"
       word_wrap="true">Inventory item</text>
      <view_border
       bevel_style="none"
       follows="left|top|right"
       height="1"
       layout="topleft"
       left="14"
       name="details_divider"
       right="-14"
       top="152" />
      <text follows="left|top" font="SansSerifSmall" height="16" layout="topleft" left="14" name="creator_label" text_color="LabelTextColor" top="168" width="74">Creator</text>
      <text follows="left|top|right" height="34" layout="topleft" left="92" name="item_creator" right="-14" text_color="White" top="168" use_ellipses="true" word_wrap="true">—</text>
      <text follows="left|top" font="SansSerifSmall" height="16" layout="topleft" left="14" name="created_label" text_color="LabelTextColor" top="210" width="74">Created</text>
      <text follows="left|top|right" height="16" layout="topleft" left="92" name="item_created" right="-14" text_color="White" top="210">—</text>
      <text follows="left|top" font="SansSerifSmall" height="16" layout="topleft" left="14" name="permissions_label" text_color="LabelTextColor" top="240" width="74">Permissions</text>
      <text follows="left|top|right" height="34" layout="topleft" left="92" name="item_permissions" right="-14" text_color="White" top="240" word_wrap="true">—</text>
      <text follows="left|top" font="SansSerifSmall" height="16" layout="topleft" left="14" name="attachment_label" text_color="LabelTextColor" top="282" width="74">Attached to</text>
      <text follows="left|top|right" height="34" layout="topleft" left="92" name="item_attachment" right="-14" text_color="White" top="282" word_wrap="true">—</text>
      <text follows="left|top" font="SansSerifSmall" height="16" layout="topleft" left="14" name="state_label" text_color="LabelTextColor" top="324" width="74">State</text>
      <text follows="left|top|right" height="34" layout="topleft" left="92" name="item_state" right="-14" text_color="White" top="324" word_wrap="true">—</text>
      <text
       follows="left|top|right"
       height="52"
       layout="topleft"
       left="14"
       name="properties_hint"
       right="-14"
       text_color="LabelTextColor"
       top="382"
       word_wrap="true">Use Properties in the item menu for complete details and editing.</text>
    </panel>
  </scroll_container>
</panel>
