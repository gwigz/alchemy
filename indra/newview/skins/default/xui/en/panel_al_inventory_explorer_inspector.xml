<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel
 background_visible="false"
 follows="all"
 height="620"
 layout="topleft"
 name="panel_al_inventory_explorer_inspector"
 width="240">
  <panel
   background_visible="false"
   bottom="-1"
   follows="all"
   left="0"
   layout="topleft"
   name="empty_panel"
   right="-1"
   top="0">
    <icon
     color="LabelTextColor"
     follows="top"
     height="24"
     image_name="InvExplorer_Inspector"
     layout="topleft"
     left="108"
     name="inspector_icon"
     top="190"
     width="24" />
    <text
     follows="left|top|right"
     font="SansSerifSmall"
     halign="center"
     height="18"
     layout="topleft"
     left="20"
     name="inspector_title"
     right="-20"
     text_color="White"
     top="224">Select an item</text>
    <text
     follows="left|top|right"
     font="SansSerifSmall"
     halign="center"
     height="34"
     layout="topleft"
     left="24"
     name="inspector_empty_message"
     right="-24"
     text_color="LabelTextColor"
     top="248"
     valign="top"
     word_wrap="true">Item details appear here.</text>
  </panel>
  <scroll_container
   bottom="-1"
   follows="all"
   layout="topleft"
   left="0"
   name="details_scroll"
   opaque="false"
   right="-1"
   top="0"
   visible="false">
    <panel
     background_visible="false"
     follows="left|top|right"
     height="516"
     layout="topleft"
     left="0"
     name="details_panel"
     top="0"
     width="238">
      <panel
       background_visible="true"
       background_opaque="false"
       bg_alpha_image="Rounded_Square"
       bg_alpha_image_overlay="InventoryExplorerControlBackgroundColor"
       border="false"
       follows="top"
       height="162"
       layout="topleft"
       left="38"
       mouse_opaque="false"
       name="preview_background"
       top="16"
       width="162" />
      <thumbnail
       fallback_image="Transparent"
       follows="top"
       height="152"
       interactable="false"
       layout="topleft"
       left="43"
       name="item_thumbnail"
       show_loading="false"
       top="21"
       width="152" />
      <icon
       color="LabelTextColor"
       follows="top"
       height="64"
       image_name="InvExplorer_Inspector"
       layout="topleft"
       left="87"
       name="item_type_icon"
       top="65"
       width="64" />
      <text
       follows="left|top|right"
       font="SansSerifSmall"
       font.style="BOLD"
       halign="center"
       height="38"
       layout="topleft"
       left="14"
       name="item_name"
       right="-14"
       text_color="White"
       top="188"
       use_ellipses="true"
       word_wrap="true">Item</text>
      <text
       follows="left|top|right"
       font="SansSerifSmall"
       halign="center"
       height="16"
       layout="topleft"
       left="14"
       name="item_state"
       right="-14"
       text_color="InventoryFavoriteColor"
       top="229" />
      <panel
       background_visible="true"
       background_opaque="false"
       bg_alpha_image="Rounded_Square"
       bg_alpha_image_overlay="InventoryExplorerControlHoverColor"
       border="false"
       follows="top"
       height="22"
       layout="topleft"
       left="59"
       name="item_type_badge"
       top="251"
       width="120">
        <text
         follows="all"
         font="SansSerifSmall"
         halign="center"
         height="16"
         layout="topleft"
         left="5"
         name="item_type"
         right="-5"
         text_color="LabelTextColor"
         top="3"
         use_ellipses="true">Inventory item</text>
      </panel>
      <view_border
       bevel_style="none"
       follows="left|top|right"
       height="1"
       highlight_dark_color="InventoryExplorerDividerColor"
       highlight_light_color="InventoryExplorerDividerColor"
       layout="topleft"
       left="14"
       name="details_divider"
       right="-14"
       shadow_dark_color="InventoryExplorerDividerColor"
       shadow_light_color="InventoryExplorerDividerColor"
       top="326" />
      <button
       follows="left|top"
       height="24"
       image_color="InventoryExplorerSelectedBackgroundColor"
       image_hover_unselected="Rounded_Square"
       image_selected="Rounded_Square"
       image_unselected="Rounded_Square"
       label="Open"
       layout="topleft"
       left="14"
       name="primary_action"
       top="286"
       width="44" />
      <button
       follows="left|top"
       height="24"
       image_color="InventoryExplorerControlBackgroundColor"
       image_hover_unselected="Rounded_Square"
       image_selected="Rounded_Square"
       image_unselected="Rounded_Square"
       label="Edit"
       layout="topleft"
       left="62"
       name="edit_action"
       top="286"
       width="40" />
      <button
       follows="left|top"
       height="24"
       image_color="InventoryExplorerControlBackgroundColor"
       image_hover_unselected="Rounded_Square"
       image_selected="Rounded_Square"
       image_unselected="Rounded_Square"
       label="Share"
       layout="topleft"
       left="106"
       name="share_action"
       top="286"
       width="48" />
      <button
       follows="left|top"
       height="24"
       image_color="InventoryExplorerControlBackgroundColor"
       image_hover_unselected="Rounded_Square"
       image_selected="Rounded_Square"
       image_unselected="Rounded_Square"
       label="Properties"
       layout="topleft"
       left="158"
       name="properties_action"
       top="286"
       width="66" />
      <text
       follows="left|top|right"
       font="SansSerifSmall"
       height="16"
       layout="topleft"
       left="14"
       name="creator_label"
       right="-14"
       text_color="LabelTextColor"
       top="341">Creator</text>
      <text
       follows="left|top|right"
       height="34"
       layout="topleft"
       left="14"
       name="item_creator"
       right="-14"
       text_color="White"
       top="358"
       use_ellipses="true"
       word_wrap="true">—</text>
      <text
       follows="left|top|right"
       font="SansSerifSmall"
       height="16"
       layout="topleft"
       left="14"
       name="permissions_label"
       right="-14"
       text_color="LabelTextColor"
       top="398">Permissions</text>
      <text
       follows="left|top|right"
       height="34"
       layout="topleft"
       left="14"
       name="item_permissions"
       right="-14"
       text_color="White"
       top="415"
       word_wrap="true">—</text>
      <text
       follows="left|top|right"
       font="SansSerifSmall"
       height="16"
       layout="topleft"
       left="14"
       name="created_label"
       right="-14"
       text_color="LabelTextColor"
       top="455">Created</text>
      <text
       follows="left|top|right"
       height="16"
       layout="topleft"
       left="14"
       name="item_created"
       right="-14"
       text_color="White"
       top="472">—</text>
    </panel>
  </scroll_container>
</panel>
